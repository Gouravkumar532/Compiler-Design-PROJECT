{
  "name": "cpp-compiler-support",
  "displayName": "C++ Language Support & Diagnostics",
  "description": "Intelligent C++ error correction, diagnostics, and language support.",
  "version": "0.1.0",
  "publisher": "cpp",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onCommand:cpp.startServer",
    "onCommand:cpp.restartServer",
    "onCommand:cpp.stopServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cpp",
        "aliases": ["C++", "cpp", "c++"],
        "extensions": [".cpp", ".h"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cpp",
        "scopeName": "source.cpp",
        "path": "./syntaxes/cpp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cpp.startServer",
        "title": "C++: Start Language Server"
      },
      {
        "command": "cpp.restartServer",
        "title": "C++: Restart Language Server"
      },
      {
        "command": "cpp.stopServer",
        "title": "C++: Stop Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "C++ Diagnostics Engine",
      "properties": {
        "cpp.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter."
        },
        "cpp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to main.py of the compiler diagnostics engine (leave blank for automatic workspace detection)."
        },
        "cpp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the C++ language server."
        }
      }
    }
  }
}
